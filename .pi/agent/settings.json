{
  "lastChangelogVersion": "0.72.1",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-4-6",
  "packages": [
    "npm:pi-sandbox",
    "git:github.com/badlogic/pi-mono",
    "npm:pi-mcp-adapter",
    "git:github.com/leblancfg/pi-ansi-themes"
  ],
  "hideThinkingBlock": true,
  "theme": "ansi-light",
