// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "buffer_line_height": "comfortable",
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "inlay_hints": {
    "enabled": true,
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "button": false,
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "work",
      "args": [],
      "projects": [
        {
          "paths": ["/proj_risc/user_dev/smcloughlin/repos/riscv_cluster/./"],
        },
      ],
    },
    {
      "host": "code",
      "args": [],
      "projects": [],
    },
  ],
  "sticky_scroll": {
    "enabled": true,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "terminal": {
    "shell": {
      "program": "fish",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "Maple Mono",
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "lsp": {
    // "dvt-ls": {
    //   "binary": {
    //     "path": "dvt-lsp-bridge",
    //     "arguments": [".", "-lang", "vlog"],
    //     "env": {
    //       "DVT_LICENSE_FILE": "20000@aus-license-1"
    //     }
    //   }
    // }
  },
  "languages": {
    "SystemVerilog": {
      // "language_servers": ["dvt-ls"],
      "language_servers": [],
    },
    "Python": {
      "language_servers": ["ruff", "ty"],
    },
  },
}
